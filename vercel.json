{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://pnsp-platform-production.up.railway.app/api/$1"
    },
    {
      "source": "/trpc/(.*)",
      "destination": "https://pnsp-platform-production.up.railway.app/trpc/$1"
    }
  ]
}
