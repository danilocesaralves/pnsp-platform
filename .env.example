# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/pnsp

# ─── Autenticação ─────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-with-at-least-32-chars
BETTER_AUTH_SECRET=another-secret-key-at-least-32-chars
BETTER_AUTH_URL=https://yourdomain.com

# ─── OAuth (Manus) ────────────────────────────────────────────────────────────
VITE_APP_ID=your-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://auth.manus.im

# ─── Proprietário da plataforma ───────────────────────────────────────────────
OWNER_OPEN_ID=owner-open-id
OWNER_NAME=Nome do Proprietário

# ─── Forge API (IA / mapas / imagens) ─────────────────────────────────────────
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=your-server-side-forge-key
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Cloudflare R2 (upload de imagens) ───────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ─── Sentry (monitoramento de erros) ─────────────────────────────────────────
SENTRY_DSN=
VITE_SENTRY_DSN=

# ─── Analytics (Umami self-hosted) ───────────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=https://analytics.yourdomain.com
VITE_ANALYTICS_WEBSITE_ID=your-website-id

# ─── CORS (produção — domínios separados por vírgula) ────────────────────────
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ─── E-mail transacional ─────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Rate limits (valores padrão — override em produção) ─────────────────────
# authLimiter: 10 req / 15 min  (hardcoded em server/_core/index.ts)
# publicLimiter: 120 req / min  (hardcoded em server/_core/index.ts)

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
